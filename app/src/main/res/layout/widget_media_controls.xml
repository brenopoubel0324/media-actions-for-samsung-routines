<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/widget_controls"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:minWidth="144dp"
    android:minHeight="48dp"
    android:background="@android:color/transparent">

    <!-- The host-sized root centers this independently sized group of controls. -->
    <LinearLayout
        tools:ignore="UselessParent"
        android:id="@+id/widget_controls_row"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:orientation="horizontal">

    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/shortcut_previous"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_outline_previous"
        android:tint="@android:color/white" />

    <!-- Zero is intentional: RemoteViews sets the user's requested spacing. -->
    <FrameLayout tools:ignore="Suspicious0dp" android:id="@+id/widget_gap_left" android:layout_width="0dp"
        android:layout_height="match_parent" android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/widget_toggle"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/shortcut_toggle"
        android:padding="1dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_outline_toggle"
        android:tint="@android:color/white" />

    <FrameLayout tools:ignore="Suspicious0dp" android:id="@+id/widget_gap_right" android:layout_width="0dp"
        android:layout_height="match_parent" android:importantForAccessibility="no" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:minWidth="48dp"
        android:minHeight="48dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/shortcut_next"
        android:padding="4dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_outline_next"
        android:tint="@android:color/white" />
    </LinearLayout>
</FrameLayout>
